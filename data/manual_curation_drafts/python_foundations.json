              "pieces": [
                {
                  "id": "python-basics-syntax-rules-table",
                  "piece_type": "reference_table",
                  "title": "Syntax rules you should recall instantly",
                  "content": {
                    "headers": [
                      "Pattern",
                      "What Python does",
                      "Example"
                    ],
                    "rows": [
                      [
                        "# comment",
                        "ignores everything after `#` on that logical line",
                        "x = 3  # ignored text"
                      ],
                      [
                        "open brackets",
                        "statement can continue on later physical lines",
                        "nums = [\\n  1,\\n  2\\n]"
                      ],
                      [
                        "backslash `\\\\`",
                        "explicitly continues one statement onto the next line",
                        "a = 'hi' + \\\\\\n    ' there'"
                      ],
                      [
                        "raw string `r'...'`",
                        "backslashes are kept literally; quotes still must match",
                        "r'c:\\\\temp\\\\file.txt'"
                      ]
                    ]
                  },
                  "source_refs": {
